# Template for ~/.config/zsh/secrets.zsh, which is untracked and chmod 600.
# bootstrap.sh copies this file there once; fill in the values on each machine.
# Only variable names belong in this tracked file, never values.

# export ZAI_API_KEY=
# export GH_NPM_REGISTRY_TOKEN=
# export NPM_AUTH_TOKEN=
# export GITHUB_READ_PACKAGES_TOKEN=
