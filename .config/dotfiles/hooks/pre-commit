#!/bin/sh
# Block commits whose added lines look like a credential.
# Bypass a false positive with: dotcfg commit --no-verify
set -eu

pattern='gh[pousr]_[A-Za-z0-9]{36}'
pattern="$pattern|github_pat_[A-Za-z0-9_]{22,}"
pattern="$pattern|(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}"
pattern="$pattern|xox[abprs]-[A-Za-z0-9-]{10,}"
pattern="$pattern|AKIA[0-9A-Z]{16}"
pattern="$pattern|-----BEGIN [A-Z ]*PRIVATE KEY-----"
pattern="$pattern|(TOKEN|SECRET|PASSWORD|API_KEY)[A-Z0-9_]*=[\"']?[A-Za-z0-9/+_.-]{16,}"

found=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  if git diff --cached -U0 --no-color -- "$f" | grep -v '^+++ ' | grep '^+' | grep -qE -- "$pattern"; then
    printf 'pre-commit: possible secret in %s\n' "$f" >&2
    found=1
  fi
done

if [ "$found" -ne 0 ]; then
  printf 'pre-commit: move secrets to ~/.config/zsh/secrets.zsh (untracked).\n' >&2
  exit 1
fi
